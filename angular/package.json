{
  "name": "sekyro-example-angular",
  "version": "0.0.0",
  "private": true,
  "description": "Sekyro AI sample: <sekyro-verification> from @sekyro/elements in an Angular app with standalone components.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "models": "node scripts/copy-models.mjs",
    "start": "npm run models && node scripts/ng.mjs serve",
    "build": "npm run models && node scripts/ng.mjs build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/material": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@sekyro/elements": "0.1.0-rc.5",
    "@sekyro/web": "0.1.0-rc.28",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@playwright/test": "1.61.1",
    "typescript": "6.0.3"
  }
}
