# Your Sandbox secret key (dashboard: your app, then API keys). Server only: never NEXT_PUBLIC_.
SEKYRO_API_KEY=
# The signing secret of your webhook endpoint (dashboard: your app, then Webhooks).
SEKYRO_WEBHOOK_SECRET=
# Optional: the flow slug or flw_ id to run. Empty runs the app's default flow.
SEKYRO_FLOW=
# Optional: the API base URL. Leave empty for https://api.sekyro.ai/api/v2.
SEKYRO_API_BASE_URL=
