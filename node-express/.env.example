# Your Sandbox secret key (dashboard: your app, then API keys). Never commit it.
SEKYRO_API_KEY=
# The signing secret of your webhook endpoint (dashboard: your app, then Webhooks).
SEKYRO_WEBHOOK_SECRET=
# Optional: the flow slug or flw_ id to run. Empty runs the app's default flow.
SEKYRO_FLOW=
# Optional: dev origins of the UI samples allowed by CORS, comma separated.
EXAMPLE_UI_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:4200
# Optional: the port this server listens on (default 4000).
PORT=
# Optional: the API base URL. Leave empty for https://api.sekyro.ai/api/v2.
SEKYRO_API_BASE_URL=
# Optional: the flow for "Raise to Identity" (a step-up). It must prove Identity on every path. Empty uses identity.
SEKYRO_STEP_UP_FLOW=
