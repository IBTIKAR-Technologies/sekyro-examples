{
  "name": "sekyro-example-node-express",
  "version": "0.0.0",
  "private": true,
  "description": "Sekyro AI sample: an Express server that creates sessions, receives webhooks and finishes Sandbox sessions with test data.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "dev:webhooks": "sekyro listen --forward-to http://localhost:4000/webhooks/sekyro",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sekyro/node": "1.0.0-rc.22",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@sekyro/cli": "0.1.0-rc.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
